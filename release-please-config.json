{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": false,
  "bootstrap-sha": "ba170bb959f64c23ec00692872bdd32a84b3cd9a",
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Novidades"
        },
        {
          "type": "fix",
          "section": "Correções"
        },
        {
          "type": "perf",
          "section": "Tarefas técnicas"
        },
        {
          "type": "refactor",
          "section": "Tarefas técnicas"
        },
        {
          "type": "chore",
          "section": "Tarefas técnicas"
        },
        {
          "type": "revert",
          "section": "Reversões"
        },
        {
          "type": "docs",
          "section": "Documentação",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Testes",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Integração contínua",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Estilo",
          "hidden": true
        }
      ]
    }
  }
}
